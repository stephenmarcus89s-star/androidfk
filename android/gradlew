#!/bin/sh
# Gradle wrapper script — downloads Gradle 8.9 on first run.
# This is the standard Gradle wrapper. The gradle-wrapper.jar must also be present.
# On GitHub Actions, we use `gradle/actions/setup-gradle` which handles this automatically.

set -e

APP_HOME=$(cd "$(dirname "$0")/.." && pwd)
CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

if [ ! -f "$CLASSPATH" ]; then
  echo "ERROR: gradle-wrapper.jar not found at $CLASSPATH"
  echo "Run 'gradle wrapper' from a machine with Gradle installed to generate it."
  exit 1
fi

exec java -classpath "$CLASSPATH" org.gradle.wrapper.GradleWrapperMain "$@"
