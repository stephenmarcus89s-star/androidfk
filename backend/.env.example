# Server
PORT=10000
NODE_ENV=production
CLIENT_URL=*

# Database
DB_PATH=./data/mirrorpro.db

# JWT
JWT_SECRET=change-this-to-a-very-long-random-string-in-production-please-32chars+
JWT_EXPIRES_IN=7d

# Admin seeding (only used on first run to create the initial admin)
ADMIN_EMAIL=admin@mirrorpro.app
ADMIN_PASSWORD=MirrorPro@2026!
ADMIN_NAME=MirrorPro Admin

# Uploads
MAX_APK_SIZE_MB=100
MAX_IMAGE_SIZE_MB=10
MAX_SCREENSHOTS=10
# Upload directory — defaults to ./data/uploads so files persist on Render disk.
# Override only if you want a different location.
UPLOAD_DIR=./data/uploads

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# App URL (auto-detected on Render via RENDER_EXTERNAL_URL, fallback below)
APP_BASE_URL=http://localhost:10000
